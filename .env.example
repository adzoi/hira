# Copy to `.env` for local development. Never commit `.env`.
#
# ── Vite (client bundle) ─────────────────────────────────────────────────────
# Only publishable / browser-safe values. Anything prefixed with VITE_ is embedded
# in the frontend build. Never put service-role keys, PayPal secrets, or SMTP passwords here.
#
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
VITE_SENTRY_DSN=your-sentry-browser-dsn

# Optional: Playwright PayPal diagnostics (skip activate-vip on /checkout)
# VITE_PAYPAL_E2E_DIAG=0

# Optional: throw a deliberate frontend error on load to verify Sentry (remove after testing)
# VITE_SENTRY_TEST_ERROR=1

# ── k6 load tests (shell only — not bundled) ─────────────────────────────────
# k6 run -e SUPABASE_FUNCTIONS_URL="https://xxx.supabase.co/functions/v1" \
#        -e SUPABASE_ANON_KEY="your-anon-key" load-test.js
#
# SUPABASE_FUNCTIONS_URL=
# SUPABASE_ANON_KEY=

# ── Playwright E2E (shell only — not bundled) ────────────────────────────────
# PAYPAL_SANDBOX_BUYER_EMAIL=
# PAYPAL_SANDBOX_BUYER_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# ── Supabase Edge Functions (set in Supabase Dashboard → Project Settings → Edge Functions) ─
# Never use VITE_ for these. Configure via `supabase secrets set` or the dashboard.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=          (or PAYPAL_CLIENT_SECRET)
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# RESEND_API_KEY=
# RESEND_FROM=
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=                    (Edge Functions — same Sentry project, server-side DSN)
# SENTRY_TEST_ERROR=1            (optional — health?sentry_test=1 returns a test error; remove after verifying)
# EMAIL_WEBHOOK_SECRET=           (preferred auth for send-notification-email; set app.email_webhook_secret in DB)
# ALERT_WEBHOOK_URL=              (Slack or Discord incoming webhook — alerts on 5xx / email failures)
# ALERT_WEBHOOK_FORMAT=slack      (optional: slack | discord; auto-detected from URL if omitted)
# ALERT_EDGE_5XX_THRESHOLD=10
# ALERT_EDGE_5XX_WINDOW_MINUTES=5
# ALERT_NOTIFY_EMAIL_FAIL_THRESHOLD=5
# ALERT_NOTIFY_EMAIL_WINDOW_MINUTES=5
# ALERT_COOLDOWN_MINUTES=15       (minimum gap between repeated alerts of the same kind)
# ALLOWED_ORIGINS=https://hira.up.railway.app,https://hira.ge,https://www.hira.ge,https://gigori-production.up.railway.app,http://localhost:5173

# ── Production static server (server.mjs) ───────────────────────────────────────
# SECURITY_COEP=1           (enable Cross-Origin-Embedder-Policy: require-corp — breaks PayPal/Supabase images unless all assets send CORP)
# SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1
# SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ── Supabase Auth (Dashboard → Authentication → Providers → Email) ───────────
# Enable "Confirm email" so accounts stay inactive until the verification link is opened.
# Dashboard → Authentication → URL Configuration → add redirect URL:
#   https://hira.ge/onboarding
