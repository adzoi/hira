{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hira-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "hira-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env",
        "server.mjs"
      ],
      "port": 3000
    }
  ]
}